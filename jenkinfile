pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'javac PalindromeChecker.java'
            }
        }
        stage('Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh 'java PalindromeChecker racecar'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh './deploy.sh'
            }
        }
    }
}


